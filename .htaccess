# ==============================================================================
# Security Hardening & Redirects (Tracey & Tracey CPAs)
# Deployment Target: InMotion Hosting (Apache)
# ==============================================================================

# 1. ENFORCE HTTPS & CANONICAL WWW
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,NE,R=301]

# 2. CLEAN URLS (Optional - Supported but not forced)
# To force clean URLs, uncomment the redirects below. 
# Currently disabled to ensure local file compatibility for updates.

# Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\.html [NC]
RewriteRule ^ %1/ [R=301,L]

# Redirect /file.html to /file
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# Internally rewrite /file to /file.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# 2. SECURITY HEADERS
<IfModule mod_headers.c>
    # Prevent browsers from sniffing MIME types (Lowers XSS risk)
    Header set X-Content-Type-Options "nosniff"
    
    # Prevent clickjacking by restricting framing to same origin
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Control how much referrer info is sent out
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Enforce HTTPS on the client side for 1 year
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Restrict feature usage (e.g., camera, microphone, geolocation)
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    
    # Content Security Policy (Base Hardening)
    # Allows self-hosted assets and Google Fonts
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self';"
</IfModule>

# 3. PERFORMANCE (Gzip Compression)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>

# 4. CACHING
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
